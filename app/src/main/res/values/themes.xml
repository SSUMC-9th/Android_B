<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FLO" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>


        <!-- Remove the title bar -->
        <item name="windowNoTitle">true</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>

    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 1. 스플래쉬 화면 배경색 지정 -->
        <item name="windowSplashScreenBackground">@android:color/white</item>

        <!-- 2. [핵심] 아이콘 경로를 원본 로고(@drawable/ic_flo_logo)로 직접 지정합니다. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_flo_logo</item>

        <!-- 3. [핵심] 아이콘 주위에 생기는 원형 배경을 투명하게 만듭니다. -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

        <!-- 5. 스플래쉬 종료 후 적용될 테마 -->
        <item name="postSplashScreenTheme">@style/Theme.FLO</item>
    </style>
</resources>