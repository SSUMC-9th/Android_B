<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- 순서 번호 -->
    <TextView
        android:id="@+id/songOrderTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 제목 -->
    <TextView
        android:id="@+id/songTitleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:text="노래 제목"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/likeIv"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/songOrderTv"
        app:layout_constraintTop_toTopOf="@id/songOrderTv" />

    <!-- 가수 -->
    <TextView
        android:id="@+id/songSingerTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="가수 이름"
        android:textSize="11sp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintStart_toStartOf="@id/songTitleTv"
        app:layout_constraintTop_toBottomOf="@id/songTitleTv"
        app:layout_constraintEnd_toStartOf="@+id/likeIv" />

    <!-- 더보기 버튼 -->
    <ImageView
        android:id="@+id/songMoreIv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/btn_player_more"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/songTitleTv"
        app:layout_constraintBottom_toBottomOf="@id/songSingerTv" />

    <!-- 재생 버튼 -->
    <ImageView
        android:id="@+id/songPlayIv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/btn_miniplayer_play"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/songTitleTv"
        app:layout_constraintBottom_toBottomOf="@id/songSingerTv"
        app:layout_constraintEnd_toStartOf="@id/songMoreIv" />

    <!-- 하트 버튼 -->
    <ImageView
        android:id="@+id/likeIv"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_my_like_off"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/songTitleTv"
        app:layout_constraintBottom_toBottomOf="@id/songSingerTv"
        app:layout_constraintEnd_toStartOf="@id/songPlayIv" />

</androidx.constraintlayout.widget.ConstraintLayout>